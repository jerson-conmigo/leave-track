{
  "name": "leave-track",
  "version": "0.1.0",
  "private": true,
  "description": "LeaveTrack \u2014 self-service leave requests, scoped manager approvals, and an auditable HR record.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "test:e2e:supabase": "playwright test --config playwright.supabase.config.ts",
    "local:start": "node scripts/local-db.mjs start",
    "local:stop": "node scripts/local-db.mjs stop",
    "local:status": "node scripts/local-status.mjs",
    "env:local": "node scripts/local-env.mjs",
    "db:migrate:local": "node scripts/local-db.mjs migrate",
    "db:reset:local": "node scripts/local-db.mjs reset",
    "db:reset": "node scripts/local-db.mjs reset",
    "db:seed:auth": "node scripts/dev-auth-seed.mjs",
    "db:check:local": "node scripts/local-db.mjs check",
    "db:push:hosted": "node scripts/hosted-db-push.mjs",
    "task:status": "node scripts/set-task-status.mjs",
    "user:invite": "node --env-file-if-exists=.env.local scripts/invite-user.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@hookform/resolvers": "7.0.8",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "geist": "1.9.2",
    "lucide-react": "1.78.0",
    "next": "16.4.6",
    "pino": "10.4.0",
    "postgres": "4.1.1",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.1",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@electric-sql/pglite": "0.6.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "husky": "9.1.7",
    "lint-staged": "17.6.2",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "supabase": "3.3.0",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  }
}
