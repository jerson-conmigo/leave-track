# ─────────────────────────────────────────────────────────────────────────────
# LeaveTrack environment variables. Copy to .env.local for local development.
# Optional for local development, tests, CI and local e2e — `npm run dev` works
# with no .env at all. Never commit real values. Validated by lib/env.ts at build,
# at server start (instrumentation.ts) and on first import.
#
# DEPLOYED ENVIRONMENTS FAIL CLOSED (TASK-019). "Deployed" = APP_ENV production|staging
# OR VERCEL_ENV production|preview (strictest wins; NODE_ENV is never used — next build
# and local e2e run with NODE_ENV=production). When deployed:
#   - DATABASE_URL and CRON_SECRET are REQUIRED (lib/env.ts REQUIRED_WHEN_DEPLOYED),
#   - E2E_RESET_TOKEN must NOT be set.
# Otherwise the build fails, or the server exits with code 1 before serving anything.
# Preview deployments therefore need a database too.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
# development | staging | production  (separate from NODE_ENV)
APP_ENV=development
# Set automatically by Vercel (production | preview | development); also marks a
# deployment. Don't set it yourself.
# VERCEL_ENV=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ── Supabase Postgres (required from Day 1 — TASK-010+) ──────────────────────
# POOLED connection (Supavisor transaction mode, port 6543). The running app
# must only ever use this URL. Append ?sslmode=require for Supabase.
# Unset → in-memory store (local dev only).
# Set → every read and write uses Postgres (B13 closed in TASK-015).
# e.g. postgres://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=
# Connections per server instance (default 5). On Vercel serverless with the
# transaction pooler, use 1–2: every function instance opens its own pool.
DATABASE_POOL_MAX=5
# DIRECT connection (port 5432) — migrations only, never used by the app.
DIRECT_URL=
# Supabase project URL + anon (public) key. REQUIRED when deployed and whenever
# AUTH_PROVIDER=supabase (TASK-024). Local Supabase: `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — never expose to the browser. Read ONLY by the operator
# invite script (npm run user:invite); the running app never uses it.
SUPABASE_SERVICE_ROLE_KEY=

# ── Jobs (required from TASK-017) ────────────────────────────────────────────
# REQUIRED for the accrual job — without it /api/jobs/accrual refuses every call
# (fails closed). Generate: openssl rand -hex 32 (no spaces/newlines). Vercel Cron
# sends it as `Authorization: Bearer $CRON_SECRET` (GET); manual runs POST the same.
CRON_SECRET=

# ── Local Supabase (TASK-054) ────────────────────────────────────────────────
# With the local stack running (npm run local:start), `npm run env:local` fills in
# AUTH_PROVIDER, the NEXT_PUBLIC_SUPABASE_* values, SUPABASE_SERVICE_ROLE_KEY, DATABASE_URL,
# DIRECT_URL, SESSION_SECRET and CRON_SECRET for you (README › Local Supabase development).
# Development refuses NON-local DATABASE_URL / DIRECT_URL / NEXT_PUBLIC_SUPABASE_URL, so
# hosted values can't be used by accident. Set to true only if you really mean to.
ALLOW_REMOTE_DATABASE=
# Local development only (TASK-056): true shows a "Fill in a local account" menu on the Supabase
# sign-in page that fills email + the local dev password (sign-in still goes through Supabase).
# Shown only with localhost/127.0.0.1 Supabase and database URLs; refused when deployed.
DEV_LOGIN_ACCOUNTS=

# ── Auth (TASK-023 / TASK-024) ───────────────────────────────────────────────
# Sign-in adapter (ADR-LeaveTrack-E004):
#   supabase = Supabase Auth: email + password, invite-only. REQUIRED when deployed.
#              Needs DATABASE_URL too (identities link to users rows in Postgres).
#   mock     = pick a seeded user, no credentials — DEV/TEST ONLY; a deployed
#              environment refuses to start with it.
AUTH_PROVIDER=mock
# HMAC key for the signed session cookie (lt-session). ≥ 32 characters. REQUIRED when
# deployed. Locally it is optional: a random per-process key is used (restarting the
# server signs everyone out). Generate: openssl rand -hex 32
SESSION_SECRET=
# Sign out after this many minutes without activity (TASK-025). Default 30; allowed 5–480.
# The 8-hour limit since sign-in is fixed. The idle warning in the app uses the same value.
SESSION_IDLE_TIMEOUT_MINUTES=

# ── Tests only ───────────────────────────────────────────────────────────────
# Enables POST /api/test/reset (e2e isolation). Set ONLY by playwright.config.ts.
# NEVER set in a deployed environment — a deployed app refuses to start with it, and
# the route is a 404 without it (or whenever DATABASE_URL is set or the app is deployed).
# E2E_RESET_TOKEN=
